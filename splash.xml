            <size>1 1</size>
            <path>./_inc/images/main1.png</path>
            <zIndex>0</zIndex>
        </image>
        <text name="welcome_message" extra="true">
            <origin>0 0</origin>
            <pos>0.12 0.13</pos>
            <size>0.76 0.07</size>
            <fontSize>0.037</fontSize>
            <alignment>center</alignment>
            <color>FFFFFFFF</color>
            <text>${welcome}</text>
            <zIndex>30</zIndex>
        </text>
        <image name="progressbar, progressbar:active">
            <origin>0 0</origin>
            <pos>0.25 0.735</pos>
            <size>0.50 0.038</size>
            <visible>true</visible>
            <zIndex>20</zIndex>
        </image>
        <image name="progressbar">
            <color>282828BB</color>
        </image>
        <image name="progressbar:active">
            <color>0079CFFF</color>
        </image>
        <text name="label">
            <pos>0.25 0.735</pos>
            <size>0.50 0.038</size>
            <fontSize>0.032</fontSize>
            <alignment>center</alignment>
            <verticalAlignment>center</verticalAlignment>
            <color>FFFFFFFF</color>
            <zIndex>140</zIndex>
        </text>
        <image name="user_avatar" extra="true">
            <origin>0.5 0.5</origin>
            <pos>0.5 0.43</pos>
            <maxSize>0.14 0.14</maxSize>
            <path>${AVATAR_PATH}</path>
            <zIndex>115</zIndex>
        </image>
        <text name="user_name_shadow" extra="true">
            <pos>0.201 0.572</pos>
            <fontSize>0.035</fontSize>
            <color>000000AA</color>
            <text>${USER_NAME}</text>
            <zIndex>119</zIndex>
            <origin>0 0</origin>
            <size>0.60 0.065</size>
            <alignment>center</alignment>
        </text>
        <text name="user_name" extra="true">
            <pos>0.20 0.57</pos>
            <fontSize>0.035</fontSize>
